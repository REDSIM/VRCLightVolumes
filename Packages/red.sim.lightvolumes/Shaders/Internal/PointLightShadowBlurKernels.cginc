            float2 DiskKernelSampleOffset(int sampleIndex, float invSampleCount) {
                float radiusSq = (sampleIndex + 0.5f) * invSampleCount;
                int directionIndex = (int)(((uint)sampleIndex * 49u) & VRCLV_DISK_KERNEL_DIRECTION_MASK);
                return diskKernelDirections[directionIndex] * sqrt(radiusSq);
            }
        #endif

        #if defined(VRCLV_SHADOW_BLUR_SPHERICAL) && defined(VRCLV_EDITOR_SHADOW_BLUR_QUALITY)
            // Editor spherical weights are evaluated procedurally; runtime weights use the tables below.
            float VRCLV_Exp(float x) {
                return exp2(x * 1.4426950408889634f);
            }

            float3 SphericalDiskSample(int sampleIndex, float invSampleCount) {
                float2 offset = DiskKernelSampleOffset(sampleIndex, invSampleCount);
                float offsetLength = length(offset);
                return float3(offset * rcp(offsetLength), offsetLength);
            }
        #endif

