// Precomputed blur kernels and editor sampling helpers.
// 128 unit directions rounded to four decimal places, sampled with stride 49.
// Disk radii use sqrt((sample + 0.5) / count); Gaussian weights use exp(-2 * radius^2).
// Spherical: unit direction XY, actual offset length Z, raw Gaussian weight W.
// Contrast: the same direction/length in spherical mode, raw offset XY otherwise.
// Include after the shader's quality, sample-count and spherical-mode defines.
#ifndef VRCLV_RUNTIME_SHADOW_BLUR_KERNELS_INCLUDED
#define VRCLV_RUNTIME_SHADOW_BLUR_KERNELS_INCLUDED

